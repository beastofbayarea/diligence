# ============================================================
# Gemini & AI Model API Configuration
# ============================================================
MODEL_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent
GEMINI_API_KEY=your-api-key-here

# Additional AI Provider Keys (OpenRouter, Grok / xAI)
# OPENROUTER_API_KEY=your-openrouter-api-key
# GROK_API_KEY=your-grok-api-key

# ============================================================
# Model Verification Configuration
# ============================================================
ENABLE_MODEL_VERIFICATION=1
MODEL_VERIFIER_BATCH_SIZE=5
MODEL_VERIFIER_TEMPERATURE=0.1
MODEL_VERIFIER_MAX_TOKENS=512

# ============================================================
# GCP / Vertex AI Configuration
# ============================================================
GCP_PROJECT_ID=cent-capital-472820
GOOGLE_APPLICATION_CREDENTIALS=gemini-service-account.json
GCP_REGION=us-central1
GEMINI_MODEL=gemini-1.5-flash

# ============================================================
# Financial & Market Data APIs (FMP, FRED, SEC EDGAR, Alpha Vantage)
# ============================================================
# Financial Modeling Prep (FMP) for market statement cross-verification
FMP_API_KEY=your-fmp-api-key

# FRED (Federal Reserve Economic Data)
FRED_API_KEY=your-fred-api-key

# Alpha Vantage & Exchange Rate API
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
EXCHANGE_RATE_API_KEY=your-exchange-rate-key

# SEC EDGAR Search Configuration
USE_EDGAR=1
SEC_USER_AGENT=DiligenceApp/1.0 (shiv@cent.capital)

# ============================================================
# Verification Thresholds
# ============================================================
VERIFICATION_HIGH_CONFIDENCE_THRESHOLD=0.9
VERIFICATION_MEDIUM_CONFIDENCE_THRESHOLD=0.6
VERIFICATION_LOW_CONFIDENCE_THRESHOLD=0.3

# ============================================================
# Developer & GitHub Metadata
# ============================================================
GITHUB_USERNAME=beastofbayarea
GITHUB_ORG=Cent-Capital
# GITHUB_TOKEN=your-github-personal-access-token

DEBUG=0
