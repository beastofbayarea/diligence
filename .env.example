# ==============================================
# MODEL-BACKED EXTRACTION & VERIFICATION (RECOMMENDED)
# ==============================================
# Use Google Gemini API for model-backed extraction and verification
# Get an API key from: https://makersuite.google.com/app/apikeys
MODEL_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent
GEMINI_API_KEY=your-api-key-here

# Alternative: use gemini-1.5-pro for more powerful (but slower) model
# MODEL_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-pro:generateContent

# ==============================================
# MODEL VERIFICATION CONFIGURATION
# ==============================================
# Enable model-based verification of extracted claims
ENABLE_MODEL_VERIFICATION=1
MODEL_VERIFIER_BATCH_SIZE=5
MODEL_VERIFIER_TEMPERATURE=0.1
MODEL_VERIFIER_MAX_TOKENS=512

# ==============================================
# GOOGLE CLOUD PLATFORM / VERTEX AI CONFIGURATION (OPTIONAL)
# ==============================================
# Your Google Cloud Project ID (for Vertex fallback)
GCP_PROJECT_ID=cent-capital-472820
# Path to a service account key managed outside Git (for Vertex fallback)
GOOGLE_APPLICATION_CREDENTIALS=gemini-service-account.json
# Google Cloud region for Vertex AI
GCP_REGION=us-central1
# Gemini model configuration (for Vertex)
GEMINI_MODEL=gemini-1.5-flash

# ==============================================
# PDF EXTRACTION CONFIGURATION
# ==============================================
# Heuristic extraction parameters
EXTRACTION_CONFIDENCE_THRESHOLD=0.3
EXTRACTION_MIN_TOKENS_PER_CLAIM=5

# ==============================================
# VERIFICATION CONFIGURATION
# ==============================================
# Enable EDGAR-based verification for financial claims
# Requires signup at https://www.sec.gov/cgi-bin/browse-edgar
USE_EDGAR=0
SEC_USER_AGENT=DiligenceApp/1.0 (your-email@example.com)

# Verification confidence thresholds
VERIFICATION_HIGH_CONFIDENCE_THRESHOLD=0.9
VERIFICATION_MEDIUM_CONFIDENCE_THRESHOLD=0.6
VERIFICATION_LOW_CONFIDENCE_THRESHOLD=0.3

# ==============================================
# MEMO GENERATION CONFIGURATION
# ==============================================
# Memo output format and style
MEMO_INCLUDE_SOURCES=1
MEMO_INCLUDE_CONFIDENCE_SCORES=1
MEMO_SORT_BY_CONFIDENCE=1

# ==============================================
# LOGGING & DEBUG
# ==============================================
# Set to 1 for verbose output
DEBUG=0
# Log file location (optional)
# LOG_FILE=logs/diligence.log
