# ==============================================
# MODEL-BACKED EXTRACTION & VERIFICATION (RECOMMENDED)
# ==============================================
# Use Google Gemini API for model-backed extraction and verification
# Get an API key from: https://makersuite.google.com/app/apikeys
MODEL_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent
GEMINI_API_KEY=your-api-key-here

# Alternative: use gemini-1.5-pro for more powerful (but slower) model
# MODEL_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-pro:generateContent

# ==============================================
# GOOGLE CLOUD PLATFORM / VERTEX AI CONFIGURATION (OPTIONAL)
# ==============================================
# Your Google Cloud Project ID (for Vertex fallback)
GCP_PROJECT_ID=cent-capital
# Path to a service account key managed outside Git (for Vertex fallback)
GOOGLE_APPLICATION_CREDENTIALS=service-account-key.json
# Google Cloud region for Vertex AI
GCP_REGION=us-central1
# Gemini model configuration (for Vertex)
GEMINI_MODEL=gemini-1.5-flash

# ==============================================
# EDGAR VERIFICATION (OPTIONAL)
# ==============================================
# Enable EDGAR-based verification for financial claims
# Requires signup at https://www.sec.gov/cgi-bin/browse-edgar
# USE_EDGAR=1
# SEC_USER_AGENT=MyApp/1.0 (your-email@example.com)
